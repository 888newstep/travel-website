<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Route optimization concurrency" enabled="true">
      <stringProp name="TestPlan.comments">All threads use different idempotency keys and submit the same explicit route order, so every request reaches the route lock and database transaction.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Test variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="service_host" elementType="Argument">
            <stringProp name="Argument.name">service_host</stringProp>
            <stringProp name="Argument.value">${__P(service_host,127.0.0.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="service_port" elementType="Argument">
            <stringProp name="Argument.name">service_port</stringProp>
            <stringProp name="Argument.value">${__P(service_port,18093)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="service_context_path" elementType="Argument">
            <stringProp name="Argument.name">service_context_path</stringProp>
            <stringProp name="Argument.value">${__P(service_context_path,/api)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="route_id" elementType="Argument">
            <stringProp name="Argument.name">route_id</stringProp>
            <stringProp name="Argument.value">${__P(route_id,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="attraction_1" elementType="Argument">
            <stringProp name="Argument.name">attraction_1</stringProp>
            <stringProp name="Argument.value">${__P(attraction_1,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="attraction_2" elementType="Argument">
            <stringProp name="Argument.name">attraction_2</stringProp>
            <stringProp name="Argument.value">${__P(attraction_2,2)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="attraction_3" elementType="Argument">
            <stringProp name="Argument.name">attraction_3</stringProp>
            <stringProp name="Argument.value">${__P(attraction_3,3)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(threads,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="token" elementType="Argument">
            <stringProp name="Argument.name">token</stringProp>
            <stringProp name="Argument.value">${__P(token,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="connect_timeout_ms" elementType="Argument">
            <stringProp name="Argument.name">connect_timeout_ms</stringProp>
            <stringProp name="Argument.value">${__P(connect_timeout_ms,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="response_timeout_ms" elementType="Argument">
            <stringProp name="Argument.name">response_timeout_ms</stringProp>
            <stringProp name="Argument.value">${__P(response_timeout_ms,30000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${service_host}</stringProp>
        <stringProp name="HTTPSampler.port">${service_port}</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.concurrentPool">20</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">${connect_timeout_ms}</stringProp>
        <stringProp name="HTTPSampler.response_timeout">${response_timeout_ms}</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Setup" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setup:init" enabled="true">
          <stringProp name="cacheKey">route-optimization-init-v1</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicInteger

def expectedThreads = vars.get('threads')
def routeId = vars.get('route_id')
def token = vars.get('token')
def attractionIds = [vars.get('attraction_1'), vars.get('attraction_2'), vars.get('attraction_3')]
if (!(expectedThreads ==~ /[1-9]\d*/) || !(routeId ==~ /[1-9]\d*/) || !token) {
    throw new IllegalArgumentException('threads, route_id, and token must be configured')
}
if (attractionIds.any { !(it ==~ /[1-9]\d*/) }) {
    throw new IllegalArgumentException('all attraction ids must be positive integers')
}

def runId = UUID.randomUUID().toString().replace('-', '')
props.setProperty('travel.route.optimization.run_id', runId)
props.setProperty('travel.route.optimization.expected_threads', expectedThreads)
props.put('travel.route.optimization.successes', new AtomicInteger())
props.put('travel.route.optimization.failures', new ConcurrentLinkedQueue())

SampleResult.setResponseCode('200')
SampleResult.setResponseMessage("runId=${runId};threads=${expectedThreads};routeId=${routeId}")
SampleResult.setResponseData("{\"runId\":\"${runId}\",\"threads\":${expectedThreads},\"routeId\":${routeId}}", 'UTF-8')
SampleResult.setDataType('text')
SampleResult.setSuccessful(true)
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Concurrent route optimizers" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${threads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Synchronize all optimizers" enabled="true">
          <intProp name="groupSize">0</intProp>
          <longProp name="timeoutInMs">30000</longProp>
        </SyncTimer>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build unique optimization request" enabled="true">
          <stringProp name="cacheKey">route-optimization-request-v1</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput

def writerNumber = ctx.getThreadNum() + 1
def runId = props.getProperty('travel.route.optimization.run_id')
vars.put('optimization_idempotency_key', "route-optimization-${runId}-${writerNumber}")
vars.put('optimization_body', JsonOutput.toJson([
        routeId: vars.get('route_id') as int,
        optimizationType: 'distance',
        parameters: [
                attractionOrder: [
                        vars.get('attraction_1') as int,
                        vars.get('attraction_2') as int,
                        vars.get('attraction_3') as int
                ]
        ]
]))
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="route-optimization:apply" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${optimization_body}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${service_context_path}/route-optimization/apply</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Optimization headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${token}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Key</stringProp>
                <stringProp name="Header.value">${optimization_idempotency_key}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validate optimization response" enabled="true">
            <stringProp name="cacheKey">route-optimization-validate-v1</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def successes = props.get('travel.route.optimization.successes')
def failures = props.get('travel.route.optimization.failures')
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (prev.getResponseCode() != '200' || body?.success != true || body?.code != 200 || body?.data != true) {
        throw new IllegalStateException("http=${prev.getResponseCode()},body=${prev.getResponseDataAsString()}")
    }
    successes.incrementAndGet()
} catch (Exception exception) {
    failures.add("thread=${ctx.getThreadNum() + 1},${exception.message}")
    prev.setSuccessful(false)
    prev.setResponseMessage(exception.message)
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Teardown" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="teardown:assert" enabled="true">
          <stringProp name="cacheKey">route-optimization-assert-v1</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput

def expected = props.getProperty('travel.route.optimization.expected_threads') as int
def successCount = props.get('travel.route.optimization.successes').get()
def failures = props.get('travel.route.optimization.failures')
def summary = [expected: expected, successes: successCount, failures: failures.size()]
SampleResult.setResponseCode('200')
SampleResult.setResponseData(JsonOutput.toJson(summary), 'UTF-8')
SampleResult.setDataType('text')
if (successCount != expected || !failures.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("route optimization verification failed: ${JsonOutput.toJson(summary)};details=${failures}")
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage("route optimization verification passed: ${JsonOutput.toJson(summary)}")
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
