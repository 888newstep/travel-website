# SkyWalking Agent 配置
# 启动时添加JVM参数: -javaagent:/path/to/skywalking-agent.jar -DSW_AGENT_NAME=your-service-name

# 服务名称
agent.service_name=${SW_AGENT_NAME:travel-service}

# SkyWalking OAP 后端地址
collector.backend_service=${SW_AGENT_COLLECTOR_BACKEND_SERVICES:127.0.0.1:11800}

# 日志级别
logging.level=${SW_LOGGING_LEVEL:INFO}

# 日志输出
logging.file_name=${SW_LOGGING_FILE_NAME:skywalking-api.log}

# 日志输出目录
logging.dir=${SW_LOGGING_DIR:logs}

# 最大日志文件大小
logging.max_file_size=${SW_LOGGING_MAX_FILE_SIZE:300MB}

# 最大历史日志文件数
logging.max_history_files=${SW_LOGGING_MAX_HISTORY_FILES:-1}