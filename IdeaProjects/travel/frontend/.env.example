# ============ 前端 API 配置 ============
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# ============ 后端网关代理目标 ============
# 场景 A：后端跑在本机（推荐，云端 middlewares：Milvus/RabbitMQ，本地 MySQL/Redis）
# 直接使用 .env 默认 http://localhost:8090 即可
#
# 场景 B：后端部署到云服务器（云端网关 8090）
# 改法一：编辑 .env 中的 VITE_PROXY_TARGET
# 改法二：启动时注入（优先级更高）
#   PowerShell:  $env:VITE_PROXY_TARGET="http://<云服务器IP>:8090"; npm run dev
#   CMD/bash:     set VITE_PROXY_TARGET=http://<云服务器IP>:8090 && npm run dev
VITE_PROXY_TARGET=http://localhost:8090

# ============ 应用配置 ============
VITE_APP_HOST=127.0.0.1
VITE_APP_PORT=3000
VITE_APP_TITLE=智慧旅游系统
