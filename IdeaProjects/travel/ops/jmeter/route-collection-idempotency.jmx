def token = props.getProperty('travel.idempotency.token')
def key = props.getProperty('travel.idempotency.key')
if (!token || !key) {
    throw new IllegalStateException('setup did not provide token and idempotency key')
}
vars.put('shared_token', token)
vars.put('shared_key', key)
]]></stringProp>
