        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setup:init-context" enabled="true">
          <stringProp name="cacheKey">route-collection-idempotency-init-v1</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference

def username = vars.get('username')?.trim()
def password = System.getenv('TRAVEL_JMETER_PASSWORD')
def routeId = vars.get('route_id')?.trim()
def expectedThreadsText = vars.get('threads')?.trim()

if (!username) {
    throw new IllegalArgumentException('username must not be blank')
}
if (!password) {
    throw new IllegalArgumentException('password must not be blank; run through run-idempotency-test.ps1')
}
if (!(routeId ==~ /[1-9]\d*/)) {
    throw new IllegalArgumentException('route_id must be a positive integer')
}
if (!(expectedThreadsText ==~ /[1-9]\d*/)) {
    throw new IllegalArgumentException('threads must be a positive integer')
}

def suppliedKey = vars.get('idempotency_key')?.trim()
def sharedKey = suppliedKey ?: "jmeter-route-collection-${UUID.randomUUID()}"
vars.put('login_body', JsonOutput.toJson([username: username, password: password]))
props.setProperty('travel.idempotency.key', sharedKey)
props.setProperty('travel.idempotency.expected_threads', expectedThreadsText)
props.put('travel.idempotency.original_200', new AtomicInteger())
props.put('travel.idempotency.replayed_200', new AtomicInteger())
props.put('travel.idempotency.conflict_409', new AtomicInteger())
props.put('travel.idempotency.unexpected', new AtomicInteger())
props.put('travel.idempotency.success_body', new AtomicReference())
props.put('travel.idempotency.failures', new ConcurrentLinkedQueue())

SampleResult.setResponseCode('200')
SampleResult.setResponseMessage("key=${sharedKey};threads=${expectedThreadsText};routeId=${routeId}")
SampleResult.setResponseData(JsonOutput.toJson([
        idempotencyKey: sharedKey,
        threads: expectedThreadsText as int,
        routeId: routeId as int
]), 'UTF-8')
SampleResult.setDataType('text')
SampleResult.setSuccessful(true)
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>

