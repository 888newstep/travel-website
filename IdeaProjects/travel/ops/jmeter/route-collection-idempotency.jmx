          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert concurrent result" enabled="true">
            <stringProp name="cacheKey">route-collection-idempotency-main-assert-v1</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.util.Locale
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicReference

AtomicInteger original200 = props.get('travel.idempotency.original_200') as AtomicInteger
AtomicInteger replayed200 = props.get('travel.idempotency.replayed_200') as AtomicInteger
AtomicInteger conflict409 = props.get('travel.idempotency.conflict_409') as AtomicInteger
AtomicInteger unexpected = props.get('travel.idempotency.unexpected') as AtomicInteger
AtomicReference successBody = props.get('travel.idempotency.success_body') as AtomicReference
ConcurrentLinkedQueue failures = props.get('travel.idempotency.failures') as ConcurrentLinkedQueue

def localFailures = []
def status = prev.getResponseCode()
def body = prev.getResponseDataAsString()
def payload
try {
    payload = new JsonSlurper().parseText(body)
} catch (Exception exception) {
    localFailures << "response is not valid JSON: ${exception.message}"
}

if (status == '200') {
    def replayed = prev.getResponseHeaders()
            .toLowerCase(Locale.ROOT)
            .readLines()
            .any { it.trim() == 'idempotency-replayed: true' }
    if (replayed) {
        replayed200.incrementAndGet()
    } else {
        original200.incrementAndGet()
    }

    if (payload != null && (payload.success != true
            || (payload.code as int) != 200
            || payload.data?.collected != true)) {
        localFailures << 'HTTP 200 must contain success=true, code=200 and data.collected=true'
    }

    def recordedBody = successBody.get()
    if (recordedBody == null) {
        successBody.compareAndSet(null, body)
        recordedBody = successBody.get()
    }
    if (recordedBody != body) {
        localFailures << 'all successful and replayed responses must have an identical body'
    }
} else if (status == '409') {
    conflict409.incrementAndGet()
    if (payload != null && (payload.success != false
            || (payload.code as int) != 409
            || !payload.message?.toString()?.contains('still being processed'))) {
        localFailures << 'HTTP 409 must describe the in-progress idempotent request'
    }
} else {
    unexpected.incrementAndGet()
    localFailures << "expected HTTP 200 or 409 but got ${status}"
}

if (localFailures.isEmpty()) {
    // JMeter 默认把 409 标记为失败；这里仅把通过业务语义校验的 409 转为成功样本。
    prev.setSuccessful(true)
} else {
    def message = "${ctx.getThread().getThreadName()}: ${localFailures.join('; ')}"
    failures.add(message)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(message)
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
