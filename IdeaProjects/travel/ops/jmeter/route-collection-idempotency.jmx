      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="teardown:aggregate" enabled="true">
          <stringProp name="cacheKey">route-collection-idempotency-aggregate-v1</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="script"><![CDATA[
import groovy.json.JsonOutput
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicInteger

def original = (props.get('travel.idempotency.original_200') as AtomicInteger).get()
def replayed = (props.get('travel.idempotency.replayed_200') as AtomicInteger).get()
def conflicts = (props.get('travel.idempotency.conflict_409') as AtomicInteger).get()
def unexpected = (props.get('travel.idempotency.unexpected') as AtomicInteger).get()
def failures = props.get('travel.idempotency.failures') as ConcurrentLinkedQueue
def expected = props.getProperty('travel.idempotency.expected_threads') as int
def actual = original + replayed + conflicts + unexpected

def summary = [
        expected: expected,
        original200: original,
        replayed200: replayed,
        conflict409: conflicts,
        unexpected: unexpected,
        assertionFailures: failures.size()
]
def validationFailures = []
if (original != 1) {
    validationFailures << "exactly one original HTTP 200 is required, actual=${original}"
}
if (actual != expected) {
    validationFailures << "expected ${expected} concurrent samples, actual=${actual}"
}
if (unexpected != 0) {
    validationFailures << "unexpected HTTP responses=${unexpected}"
}
if (!failures.isEmpty()) {
    validationFailures << "main assertion failures=${failures.size()}"
}

SampleResult.setResponseData(JsonOutput.toJson(summary), 'UTF-8')
SampleResult.setDataType('text')
SampleResult.setResponseMessage("original=${original},replayed=${replayed},conflict=${conflicts},unexpected=${unexpected}")
if (validationFailures.isEmpty()) {
    SampleResult.setResponseCode('200')
    SampleResult.setSuccessful(true)
} else {
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage(validationFailures.join('; '))
    SampleResult.setSuccessful(false)
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="teardown:replay" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;routeId&quot;:${route_id}}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">/api/v1/route-collections/toggle</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
