          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert replay" enabled="true">
            <stringProp name="cacheKey">route-collection-idempotency-replay-assert-v1</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper
import java.util.Locale
import java.util.concurrent.atomic.AtomicReference

def failures = []
def body = prev.getResponseDataAsString()
if (prev.getResponseCode() != '200') {
    failures << "expected HTTP 200 but got ${prev.getResponseCode()}"
}
def replayed = prev.getResponseHeaders()
        .toLowerCase(Locale.ROOT)
        .readLines()
        .any { it.trim() == 'idempotency-replayed: true' }
if (!replayed) {
    failures << 'Idempotency-Replayed response header must be true'
}
try {
    def payload = new JsonSlurper().parseText(body)
    if (payload.success != true || (payload.code as int) != 200 || payload.data?.collected != true) {
        failures << 'replayed body must contain data.collected=true'
    }
} catch (Exception exception) {
    failures << "response is not valid JSON: ${exception.message}"
}
def expectedBody = (props.get('travel.idempotency.success_body') as AtomicReference).get()
if (!expectedBody || expectedBody != body) {
    failures << 'replayed response body differs from the original successful response'
}
if (!failures.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failures.join('; '))
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

