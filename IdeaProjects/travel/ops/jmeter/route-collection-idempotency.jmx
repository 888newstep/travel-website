          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert login" enabled="true">
            <stringProp name="cacheKey">route-collection-idempotency-login-v1</stringProp>
            <stringProp name="filename"/>
            <stringProp name="parameters"/>
            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def failures = []
if (prev.getResponseCode() != '200') {
    failures << "expected HTTP 200 but got ${prev.getResponseCode()}"
}

def payload
try {
    payload = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception exception) {
    failures << "response is not valid JSON: ${exception.message}"
}

if (payload != null && payload.success != true) {
    failures << "login response success must be true"
}
def token = vars.get('auth_token')
if (!token || token == '__TOKEN_NOT_FOUND__') {
    failures << 'token was not found at $.data.token'
} else {
    props.setProperty('travel.idempotency.token', token)
}

if (!failures.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failures.join('; '))
}
]]></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
