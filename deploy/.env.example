# ============================================
# 环境变量模板（CI 用默认值 / 本地开发参考）
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# ============================================

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_website
DB_USERNAME=root
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- JWT ---
# 必须 ≥32 字节，生产环境务必修改
JWT_SECRET=***-for-ci-only-must-be-long-enough-32-chars

# --- 高德 API（路线规划 + POI 搜索 + 天气） ---
AMAP_API_KEY=***

# --- Nacos（本地开发可关闭） ---
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=public

# --- XXL-Job ---
XXL_JOB_ACCESS_TOKEN=

# --- Sentinel ---
SENTINEL_DASHBOARD=localhost:8080

# --- Seata ---
SEATA_SERVER_ADDR=localhost:9091

# --- 魔搭 Token（notebook 数据加载用，不进仓库） ---
GITEE_TOKEN=***
MODELSCOPE_TOKEN=***
DASHSCOPE_TOKEN=***